#!/usr/bin/env bash
# Heroku worker: runs the Hyperwatch instances and a Cloudflare Tunnel side by
# side. There is no web process, so Watch is only reachable through the tunnel
# and its Cloudflare Access policy. If either process exits, the other is
# stopped and this exits non-zero so Heroku restarts the dyno.
set -uo pipefail
cd "$(dirname "$0")/.."

if [ -z "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  echo "CLOUDFLARE_TUNNEL_TOKEN is not set: Watch would be unreachable" >&2
  exit 1
fi

# -v streams the output of the Hyperwatch process to the Heroku logs: inputs
# connecting, persistence summaries, warnings and errors. all.js prints no
# per-request lines (the per-service configs do: don't run them here with -v).
node start.js -v &
watch_pid=$!

vendor/cloudflared tunnel --no-autoupdate run --token "$CLOUDFLARE_TUNNEL_TOKEN" &
tunnel_pid=$!

stop() {
  kill -TERM "$watch_pid" "$tunnel_pid" 2>/dev/null
  wait
}
trap 'stop; exit 0' TERM INT

wait -n
status=$?
echo "A process exited ($status), stopping" >&2
stop
exit 1
